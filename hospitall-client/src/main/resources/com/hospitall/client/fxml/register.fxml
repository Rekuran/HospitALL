<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospitall.client.controller.RegisterController"
      alignment="CENTER" spacing="10" prefWidth="300" prefHeight="250">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Create Account" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <TextField fx:id="usernameField" promptText="Username"/>
    <PasswordField fx:id="passwordField" promptText="Password"/>
    
    <Button text="Register" onAction="#handleRegister" prefWidth="Infinity"/>
    <Button text="Back to Login" onAction="#handleBack" prefWidth="Infinity" style="-fx-background-color: transparent;"/>
    
    <Label fx:id="statusLabel" textFill="red"/>
</VBox>
