<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospitall.client.controller.AdminOverviewController">
    <Label text="Admin Overview" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    
    <HBox spacing="20">
        <VBox style="-fx-border-color: #ccc; -fx-border-radius: 5; -fx-padding: 20;" prefWidth="200">
            <Label text="Total Patients" />
            <Label fx:id="patientCountLabel" text="Loading..." style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-border-color: #ccc; -fx-border-radius: 5; -fx-padding: 20;" prefWidth="200">
            <Label text="Total Doctors" />
            <Label fx:id="doctorCountLabel" text="Loading..." style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        </VBox>
        <VBox style="-fx-border-color: #ccc; -fx-border-radius: 5; -fx-padding: 20;" prefWidth="200">
            <Label text="Appointments" />
            <Label fx:id="appointmentCountLabel" text="Loading..." style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>
</VBox>
