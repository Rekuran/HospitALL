<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospitall.client.controller.LoginController" styleClass="login-container">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="HospitALL Login" styleClass="header-label" />
    <TextField fx:id="usernameField" promptText="Username" />
    <PasswordField fx:id="passwordField" promptText="Password" />
    <Button text="Login" onAction="#handleLogin" styleClass="login-button" />
    <Button text="Create Account" onAction="#handleRegister" styleClass="register-button" />
    <Label fx:id="messageLabel" style="-fx-text-fill: red;" />
</VBox>
