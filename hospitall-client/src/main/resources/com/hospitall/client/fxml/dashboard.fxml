<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainView" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.hospitall.client.controller.DashboardController" styleClass="dashboard-root">
    <left>
        <VBox styleClass="sidebar" spacing="10" prefWidth="200">
            <Label text="HospitALL" styleClass="sidebar-header"/>
            <Button text="Dashboard" maxWidth="Infinity" styleClass="nav-button" onAction="#showDashboard"/>
            <Button text="Patients" maxWidth="Infinity" styleClass="nav-button" onAction="#showPatients"/>
            <Button text="Doctors" maxWidth="Infinity" styleClass="nav-button" onAction="#showDoctors"/>
            <Button text="Appointments" maxWidth="Infinity" styleClass="nav-button" onAction="#showAppointments"/>
            <Button text="Billing" maxWidth="Infinity" styleClass="nav-button" onAction="#showBilling"/>
        </VBox>
    </left>
    <center>
        <VBox fx:id="contentArea" spacing="20" style="-fx-padding: 20;">
            <Label text="Welcome back, Administrator" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <TilePane hgap="20" vgap="20">
                <VBox styleClass="summary-card"><Label text="Total Patients" /><Label text="1,240" styleClass="card-value"/></VBox>
                <VBox styleClass="summary-card"><Label text="Doctors" /><Label text="45" styleClass="card-value"/></VBox>
                <VBox styleClass="summary-card"><Label text="Appointments" /><Label text="12" styleClass="card-value"/></VBox>
                <VBox styleClass="summary-card"><Label text="Pending Bills" /><Label text="8" styleClass="card-value"/></VBox>
            </TilePane>
        </VBox>
    </center>
</BorderPane>
