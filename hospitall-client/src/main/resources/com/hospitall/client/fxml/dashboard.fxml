<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainView" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.hospitall.client.controller.DashboardController" styleClass="dashboard-root">
    <left>
        <VBox styleClass="sidebar" spacing="10" prefWidth="200">
            <Label text="Admin Dashboard" styleClass="sidebar-header"/>
            <Button text="Admin Overview" maxWidth="Infinity" styleClass="nav-button" onAction="#showAdminOverview"/>
            <Button text="Hospital Profile" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Staff &amp; Users" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Roles &amp; Permissions" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="System Settings" maxWidth="Infinity" styleClass="nav-button"/>
            <Button text="Patients" maxWidth="Infinity" styleClass="nav-button" onAction="#showPatients"/>
            <Button text="Billing" maxWidth="Infinity" styleClass="nav-button" onAction="#showBilling"/>
            <Button text="Log Out" maxWidth="Infinity" styleClass="nav-button" onAction="#handleLogout"/>
        </VBox>
    </left>
    <center>
        <VBox fx:id="contentArea" spacing="20" style="-fx-padding: 20;">
            <Label text="Welcome to HospitALL Dashboard" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>
    </center>
</BorderPane>
