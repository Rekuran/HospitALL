<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hospitall.client.controller.PatientsController">
    <Label text="Patients Management" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    
    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="Search by ID, Name, Contact..."/>
        <Button text="Search" onAction="#handleSearch"/>
    </HBox>

    <HBox spacing="10">
        <TextField fx:id="idField" promptText="ID"/>
        <TextField fx:id="nameField" promptText="Name"/>
        <TextField fx:id="ageField" promptText="Age"/>
        <TextField fx:id="genderField" promptText="Gender"/>
        <TextField fx:id="contactField" promptText="Contact"/>
    </HBox>
    <HBox spacing="10">
        <Button text="Add Patient" onAction="#handleAddPatient"/>
        <Button text="Update" onAction="#handleEdit"/>
        <Button text="Delete" onAction="#handleDelete"/>
    </HBox>
    <Label fx:id="statusLabel" textFill="red"/>
    
    <TableView fx:id="patientTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
            <TableColumn fx:id="nameCol" text="Name" prefWidth="150"/>
            <TableColumn fx:id="ageCol" text="Age" prefWidth="50"/>
            <TableColumn fx:id="genderCol" text="Gender" prefWidth="80"/>
            <TableColumn fx:id="contactCol" text="Contact" prefWidth="150"/>
            <TableColumn fx:id="createdAtCol" text="Created" prefWidth="150"/>
            <TableColumn fx:id="updatedAtCol" text="Updated" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
